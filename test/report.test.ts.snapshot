exports[`formatPreviewComment and formatPreviewSummary > calls out a new manifest, registry, target and export changes 1`] = `
<!-- aireg-publish-preview -->
<h3>✅ Ready to merge</h3>
<p>Merging publishes <b>2 artifacts</b> to <code>team/platform</code> · 1 new · 1 update</p>
<p>📝 This pull request adds <code>.registry/manifest.yml</code>, so everything it declares is new.</p>
<p>📝 <b>This pull request changes the manifest:</b> registries: adds <code>team</code>, changes <code>acme</code>, removes <code>old</code>; target: <code>acme/engineering</code> → <code>team/platform</code>.</p>
<p>This pull request stops exporting skill <code>lint</code> and agent <code>planner</code>.</p>

<table>
<tr><th align="left" width="330">Artifact</th><th align="left" width="250">Change</th><th align="left" width="180">Version</th></tr>
<tr><td><code>review</code> <sub>skill</sub></td><td>🔄 Update</td><td><code>0.3.1</code> → <code>0.3.2</code></td></tr>
<tr><td><code>triage</code> <sub>agent</sub></td><td>🆕 New</td><td><code>0.1.0</code></td></tr>
</table>
`;

